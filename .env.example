# ── Client-side values (safe to expose: embedded in the app bundle) ──────────
# Supabase project URL + anon key. The anon key is public by design; data is
# protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# USDA FoodData Central key. Free + rate-limited only, so acceptable client-side.
EXPO_PUBLIC_USDA_API_KEY=your-usda-key

# ── Server-side secrets — NEVER put these in this file or any EXPO_PUBLIC var ─
# They belong to the ai-proxy Edge Function. Set them with the Supabase CLI:
#   supabase secrets set OPENAI_API_KEY=sk-... ANTHROPIC_API_KEY=sk-ant-... \
#     NUTRITIONIX_APP_ID=... NUTRITIONIX_APP_KEY=... DEFAULT_AI_PROVIDER=openai
